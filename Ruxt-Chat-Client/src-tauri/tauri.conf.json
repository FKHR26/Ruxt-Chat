{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ruxt-chat-client",
  "version": "0.1.0",
  "identifier": "com.fkhr26.ruxt-chat-client",
  "build": {
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ruxt-chat-client",
        "width": 800,
        "height": 600,
        "decorations": false,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
